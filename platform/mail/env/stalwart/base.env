# What the stalwart Process receives (deploy-kit spec/v1, chapter 10, Configuration). Every
# container of the pod receives it: the server and the stalwart-apply sidecar.
#
# The server seeds its admin from this one variable, in the form user:password, so the
# sidecar can sign in and the web admin is reachable behind forward-auth. A value is one
# placeholder, never two, so Vault holds the pair as its own key, which
# bootstrap/secrets.sh --only mail writes from the two below.
STALWART_RECOVERY_ADMIN=${secret:secret/data/platform/mail#stalwart.recovery_admin}

# The sidecar applies the provisioner manifest (config/manifest.json) against the admin API
# on the pod's own loopback; it reads the manifest at its default path.
STALWART_URL=http://127.0.0.1:8080
STALWART_USER=${secret:secret/data/platform/mail#stalwart.admin_user}
STALWART_PASSWORD=${secret:secret/data/platform/mail#stalwart.admin_password}
# The DNS-01 token the sidecar renews in the datastore on every start.
CF_DNS_API_TOKEN=${secret:secret/data/platform/edge#cloudflare.dns_api_token}

# The password of each mailbox the manifest manages, named there by passwordRef.envVar and
# read from the path of the Application that signs in with it, so the two cannot drift.
AUTH_MAIL_PASSWORD=${secret:secret/data/auth-api#mail.password}
ACCOUNT_MAIL_PASSWORD=${secret:secret/data/platform/mail#account.password}
NOTES_MAIL_PASSWORD=${secret:secret/data/platform/outline#smtp.password}
LATEX_MAIL_PASSWORD=${secret:secret/data/platform/overleaf#smtp.password}
