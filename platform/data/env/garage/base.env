# What the garage Process receives (deploy-kit spec/v1, chapter 10, Configuration). Garage
# reads its cluster secret and admin token from these two variables in place of the files the
# old path mounts, so garage.toml stays an Asset with nothing secret in it. The keys are the
# live document's own.
GARAGE_RPC_SECRET=${secret:secret/data/platform/garage#rpc_secret}
GARAGE_ADMIN_TOKEN=${secret:secret/data/platform/garage#admin_token}
