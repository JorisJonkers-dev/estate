# What the postgres Process receives (deploy-kit spec/v1, chapter 10, Configuration).
# The image's entrypoint reads these only to initialise an empty data directory; the old
# path's Vault Agent template wrote the same three.
POSTGRES_DB=postgres
POSTGRES_USER=${secret:secret/data/platform/postgres#postgres.user}
POSTGRES_PASSWORD=${secret:secret/data/platform/postgres#postgres.password}
