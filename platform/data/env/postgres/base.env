# What the postgres Process receives (deploy-kit spec/v1, chapter 10, Configuration). A Process's
# environment reaches every container of its pod, so the server and the exporter sidecar read
# one file.
#
# The image's entrypoint reads these three only to initialise an empty data directory; the old
# path's Vault Agent template wrote the same three.
POSTGRES_DB=postgres
POSTGRES_USER=${secret:secret/data/platform/postgres#postgres.user}
POSTGRES_PASSWORD=${secret:secret/data/platform/postgres#postgres.password}
# The exporter sidecar dials the server on localhost as the superuser, as the old path's does.
DATA_SOURCE_URI=localhost:5432/postgres?sslmode=disable
DATA_SOURCE_USER=${secret:secret/data/platform/postgres#postgres.user}
DATA_SOURCE_PASS=${secret:secret/data/platform/postgres#postgres.password}
