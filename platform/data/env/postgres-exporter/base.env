# What the postgres-exporter Process receives (deploy-kit spec/v1, chapter 10, Configuration).
# The old path's sidecar dialled localhost; this Process reaches the postgres Service in its
# own namespace. The superuser, as on the old path.
DATA_SOURCE_URI=postgres:5432/postgres?sslmode=disable
DATA_SOURCE_USER=${secret:secret/data/platform/postgres#postgres.user}
DATA_SOURCE_PASS=${secret:secret/data/platform/postgres#postgres.password}
# The custom queries, as the old path's --extend.query-path flag named them.
PG_EXPORTER_EXTEND_QUERY_PATH=/etc/postgres-exporter/queries.yaml
