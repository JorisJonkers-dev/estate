# What the rabbitmq Process receives (deploy-kit spec/v1, chapter 10, Configuration).
# The broker's own administrator, which the old path's Vault Agent template wrote. The node
# name follows the pod's, so a new pod starts a fresh database and creates this user again.
RABBITMQ_DEFAULT_USER=${secret:secret/data/platform/rabbitmq#rabbitmq.user}
RABBITMQ_DEFAULT_PASS=${secret:secret/data/platform/rabbitmq#rabbitmq.password}
# Where Erlang keeps its cookie: a writable path, so the cookie is written fresh, owner-only, at
# each start, never read from the claim, where the pod's fsGroup leaves it group-readable and
# Erlang then refuses it.
HOME=/tmp
