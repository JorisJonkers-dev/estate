# Gatus reads every file in this directory: its own settings (the Asset) and
# one file per Project's external checks.
GATUS_CONFIG_PATH=/data/config

# The checks sidecar (kiwigrid's k8s-sidecar, the image the lock pins as
# gatus-checks): it watches every ConfigMap labelled as a Project's external
# checks, in every namespace, and writes each one's file into Gatus's
# directory. A Process's environment reaches every container of its pod, so
# Gatus is handed these too and ignores them.
LABEL=estate.jorisjonkers.dev/external-checks
LABEL_VALUE=true
FOLDER=/data/config
RESOURCE=configmap
NAMESPACE=ALL
METHOD=WATCH
UNIQUE_FILENAMES=true
# The sidecar's health server, off Gatus's own 8080.
HEALTH_PORT=8081
