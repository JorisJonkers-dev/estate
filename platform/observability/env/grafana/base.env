# Grafana signs people in itself, against auth-api, exactly as the old path's
# grafana.ini does (fleet-infra cluster/flux/apps/observability/grafana/
# release.yaml). auth-api registers the client `grafana` with the redirect
# https://grafana.jorisjonkers.dev/login/generic_oauth; its secret is read from
# the document fleet-infra's grafana-oidc-client VaultStaticSecret reads.
# Once the estate runs the identity Project's provider, this becomes the
# worked example's native Client.

GF_SERVER_ROOT_URL=${exposure:grafana.public#url}

GF_AUTH_GENERIC_OAUTH_ENABLED=true
GF_AUTH_GENERIC_OAUTH_NAME=personal-stack
GF_AUTH_GENERIC_OAUTH_CLIENT_ID=grafana
GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET=${secret:secret/data/platform/observability#grafana.oauth_client_secret}
GF_AUTH_GENERIC_OAUTH_SCOPES=openid profile email
GF_AUTH_GENERIC_OAUTH_AUTH_URL=https://auth.jorisjonkers.dev/api/oauth2/authorize
GF_AUTH_GENERIC_OAUTH_TOKEN_URL=https://auth.jorisjonkers.dev/api/oauth2/token
GF_AUTH_GENERIC_OAUTH_API_URL=https://auth.jorisjonkers.dev/api/userinfo
GF_AUTH_GENERIC_OAUTH_LOGIN_ATTRIBUTE_PATH=preferred_username
GF_AUTH_GENERIC_OAUTH_NAME_ATTRIBUTE_PATH=name
GF_AUTH_GENERIC_OAUTH_EMAIL_ATTRIBUTE_PATH=email
# auth-api mints ROLE_ADMIN for admins: they get GrafanaAdmin, everyone else Viewer.
GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH=contains(roles[*], 'ROLE_ADMIN') && 'GrafanaAdmin' || 'Viewer'
GF_AUTH_GENERIC_OAUTH_ALLOW_ASSIGN_GRAFANA_ADMIN=true
GF_AUTH_GENERIC_OAUTH_AUTO_LOGIN=true
GF_AUTH_GENERIC_OAUTH_USE_PKCE=false

# The app plugins the chart installs live. Pyroscope's data source is core.
GF_PLUGINS_PREINSTALL=grafana-pyroscope-app,grafana-exploretraces-app,grafana-lokiexplore-app,grafana-metricsdrilldown-app
