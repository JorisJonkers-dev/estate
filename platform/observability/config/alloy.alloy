// The log collector: one copy that tails every pod's log through the
// Kubernetes API, and the receiver for the sites' browser telemetry. Both are
// fleet-infra's Alloy configuration (cluster/flux/apps/observability/alloy/
// release.yaml), unchanged but for the addresses. Its OTLP pipeline moved to
// the otel-collector Application.

logging {
  level  = "info"
  format = "logfmt"
}

discovery.kubernetes "pods" {
  role = "pod"
}

discovery.relabel "pods" {
  targets = discovery.kubernetes.pods.targets

  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }

  // The workload's app.kubernetes.io/name, as `service_name`: the join key
  // the dashboards and Grafana's traces-to-logs link look logs up by.
  rule {
    source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
    target_label  = "service_name"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    target_label  = "container"
  }

  // The pod's release, for the estate dashboard; absent without the label.
  rule {
    source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_version"]
    target_label  = "version"
  }
}

// Spring services log JSON through the Logstash encoder: `level` becomes a
// label, traceId and spanId structured metadata (never labels).
loki.process "pods" {
  forward_to = [loki.write.default.receiver]

  stage.json {
    expressions = {
      level   = "level",
      traceId = "traceId",
      spanId  = "spanId",
    }
  }

  stage.labels {
    values = {
      level = "",
    }
  }

  stage.structured_metadata {
    values = {
      traceId = "",
      spanId  = "",
    }
  }
}

loki.source.kubernetes "pods" {
  targets    = discovery.relabel.pods.output
  forward_to = [loki.process.pods.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// Browser RUM: the sites post Faro's envelope to faro.jorisjonkers.dev, which
// routes here. Logs go to Loki; spans to the collector, which drops health
// checks and names them like every other span.
faro.receiver "default" {
  server {
    listen_address       = "0.0.0.0"
    listen_port          = 12347
    cors_allowed_origins = [
      "https://jorisjonkers.dev",
      "https://auth.jorisjonkers.dev",
      "https://agents.jorisjonkers.dev",
    ]
  }

  extra_log_labels = {
    source = "faro",
  }

  output {
    logs   = [loki.write.default.receiver]
    traces = [otelcol.exporter.otlp.collector.input]
  }
}

otelcol.exporter.otlp "collector" {
  client {
    endpoint = "otel-collector:4317"
    tls {
      insecure = true
    }
  }
}
