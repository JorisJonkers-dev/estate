{"uid":"node-telemetry","title":"Node telemetry (CPU / RAM / temp / GPU)","schemaVersion":39,"version":1,"refresh":"30s","time":{"from":"now-6h","to":"now"},"timezone":"browser","editable":false,"tags":["hardware","nodes","overview"],"templating":{"list":[{"name":"node","label":"node","type":"query","datasource":{"type":"prometheus","uid":"prometheus"},"query":"label_values(node_uname_info, nodename)","refresh":1,"includeAll":true,"multi":true,"allValue":".*","current":{"text":"All","value":"$__all"}}]},"panels":[{"type":"stat","title":"Nodes reporting","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"h":4,"w":6,"x":0,"y":0},"targets":[{"expr":"count(count by (nodename) (node_uname_info{nodename=~\"$node\"}))","refId":"A"}],"options":{"reduceOptions":{"calcs":["lastNotNull"],"fields":"","values":false},"colorMode":"value","graphMode":"area","textMode":"auto"},"fieldConfig":{"defaults":{"unit":"short","thresholds":{"mode":"absolute","steps":[{"color":"red","value":null},{"color":"green","value":1}]}},"overrides":[]}},{"type":"stat","title":"Peak CPU","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"h":4,"w":6,"x":6,"y":0},"targets":[{"expr":"max((100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)) * on(instance) group_left(nodename) node_uname_info{nodename=~\"$node\"})","refId":"A"}],"options":{"reduceOptions":{"calcs":["lastNotNull"],"fields":"","values":false},"colorMode":"value","graphMode":"area","textMode":"auto"},"fieldConfig":{"defaults":{"unit":"percent","thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"yellow","value":75},{"color":"red","value":90}]},"decimals":1},"overrides":[]}},{"type":"stat","title":"Peak RAM","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"h":4,"w":6,"x":12,"y":0},"targets":[{"expr":"max(((1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100) * on(instance) group_left(nodename) node_uname_info{nodename=