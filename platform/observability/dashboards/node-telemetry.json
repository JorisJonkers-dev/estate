er consuming pod."},{"type":"timeseries","title":"GPU temperature by node","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"h":7,"w":12,"x":12,"y":42},"targets":[{"expr":"avg by (hostname, gpu, modelName) (DCGM_FI_DEV_GPU_TEMP{hostname=~\"$node\"})","legendFormat":"{{hostname}} GPU{{gpu}}","refId":"A"}],"options":{"legend":{"displayMode":"table","placement":"bottom","calcs":["lastNotNull","mean","max"]},"tooltip":{"mode":"multi","sort":"desc"}},"fieldConfig":{"defaults":{"unit":"celsius","custom":{"drawStyle":"line","fillOpacity":10,"lineWidth":2,"showPoints":"never","spanNulls":true}},"overrides":[]}},{"type":"timeseries","title":"Power draw (GPU)","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"h":7,"w":12,"x":0,"y":49},"targets":[{"expr":"avg by (hostname, gpu, modelName) (DCGM_FI_DEV_POWER_USAGE{hostname=~\"$node\"})","legendFormat":"{{hostname}} GPU{{gpu}} ({{modelName}})","refId":"A"}],"options":{"legend":{"displayMode":"table","placement":"bottom","calcs":["lastNotNull","mean","max"]},"tooltip":{"mode":"multi","sort":"desc"}},"fieldConfig":{"defaults":{"unit":"watt","custom":{"drawStyle":"line","fillOpacity":10,"lineWidth":2,"showPoints":"never","spanNulls":true}},"overrides":[]},"description":"GPU package power via DCGM. CPU package power (RAPL) is NOT collected: node-exporter runs unprivileged and the kernel restricts /sys/class/powercap/*/energy_uj to root since 5.10. The three Pis are arm64 and have no RAPL at all, and a VPS guest cannot see powercap either -- so RAPL would only ever cover the two amd64 desktops. Whole-node wall power needs external metering."}]}

