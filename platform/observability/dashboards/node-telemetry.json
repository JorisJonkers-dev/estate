tNull","mean","max"]},"tooltip":{"mode":"multi","sort":"desc"}},"fieldConfig":{"defaults":{"unit":"percent","custom":{"drawStyle":"line","fillOpacity":10,"lineWidth":2,"showPoints":"never","spanNulls":true},"min":0,"max":100},"overrides":[]}},{"type":"timeseries","title":"Memory used","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"h":7,"w":12,"x":12,"y":7},"targets":[{"expr":"((1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100) * on(instance) group_left(nodename) node_uname_info{nodename=~\"$node\"}","legendFormat":"{{nodename}}","refId":"A"}],"options":{"legend":{"displayMode":"table","placement":"bottom","calcs":["lastNotNull","mean","max"]},"tooltip":{"mode":"multi","sort":"desc"}},"fieldConfig":{"defaults":{"unit":"percent","custom":{"drawStyle":"line","fillOpacity":10,"lineWidth":2,"showPoints":"never","spanNulls":true},"min":0,"max":100},"overrides":[]}},{"type":"timeseries","title":"Load average per core","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"h":7,"w":12,"x":0,"y":14},"targets":[{"expr":"(node_load1 / on(instance) group_left() count by (instance) (node_cpu_seconds_total{mode=\"idle\"})) * on(instance) group_left(nodename) node_uname_info{nodename=~\"$node\"}","legendFormat":"1m {{nodename}}","refId":"A"},{"expr":"(node_load15 / on(instance) group_left() count by (instance) (node_cpu_seconds_total{mode=\"idle\"})) * on(instance) group_left(nodename) node_uname_info{nodename=~\"$node\"}","legendFormat":"15m {{nodename}}","refId":"B"}],"options":{"legend":{"displayMode":"table","placement":"bottom","calcs":["lastNotNull","mean","max"]},"tooltip":{"mode":"multi","sort":"desc"}},"fieldConfig":{"defaults":{"unit":"short","custom":{"drawStyle":"line","fillOpacity":10,"lineWidth":2,"showPoints":"never","spanNulls":true}},"overrides":[]},"description":"Load normalised by core count, so 1.0 means fully committed on any node regardless of size."},{"type":"timeseries","title":"Temperature (hwmon sensor