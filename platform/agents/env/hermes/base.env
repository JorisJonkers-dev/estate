# hermes runs its gateway, and serves its dashboard on the dashboard surface.
# The dashboard signs people in itself, as the public PKCE client `hermes` of
# auth-api, whose issuer is auth's public URL; its callback,
# <public url>/auth/callback, is the redirect URI auth-api registers for it.
HERMES_DASHBOARD=1
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_PORT=9119
HERMES_DASHBOARD_PUBLIC_URL=${exposure:hermes.public#url}
HERMES_DASHBOARD_OIDC_ISSUER=${exposure:auth.public#url}
HERMES_DASHBOARD_OIDC_CLIENT_ID=hermes
HERMES_DASHBOARD_OIDC_SCOPES=openid profile email
API_SERVER_ENABLED=false
HERMES_SKIP_CONFIG_MIGRATION=false
# An emptyDir at /run is root-owned and world-writable, which s6-overlay, its
# supervisor, refuses from a non-root start unless told to accept it.
S6_YES_I_WANT_A_WORLD_WRITABLE_RUN_BECAUSE_KUBERNETES=1

# The model providers it calls, and the tokens of the MCP servers it reaches,
# which hermes expands into its seeded config itself. The old path wrote the
# provider keys, and GITHUB_PERSONAL_ACCESS_TOKEN from github-pat, into
# /opt/data/.env; here they are the process's own environment.
ANTHROPIC_API_KEY=${secret:secret/data/agents/hermes#anthropic-api-key}
OPENAI_API_KEY=${secret:secret/data/agents/hermes#openai-api-key}
OPENROUTER_API_KEY=${secret:secret/data/agents/hermes#openrouter-api-key}
GITHUB_PAT=${secret:secret/data/agents/hermes#github-pat}
GITHUB_PERSONAL_ACCESS_TOKEN=${secret:secret/data/agents/hermes#github-pat}
HINDSIGHT_API_TOKEN=${secret:secret/data/agents/hermes#hindsight-api-token}
MEMORY_API_KEY=${secret:secret/data/agents/hermes#memory-api-key}
OVERLEAF_SESSION=${secret:secret/data/agents/hermes#overleaf-session}
