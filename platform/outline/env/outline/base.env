# What the outline Process receives (deploy-kit spec/v1, chapter 10, Configuration).
NODE_ENV=production
URL=${exposure:outline.public#url}
PORT=3000
# The edge terminates TLS; outline's own https redirect would come on top of it.
FORCE_HTTPS=false
# Node forks this many processes; the default is the node's CPU count.
WEB_CONCURRENCY=2

DATABASE_HOST=${dependency:platform-postgres.host}
DATABASE_PORT=${dependency:platform-postgres.port}
DATABASE_NAME=outline_db
DATABASE_USER=${dependency:platform-postgres.username}
DATABASE_PASSWORD=${dependency:platform-postgres.password}
PGSSLMODE=disable

# Queues, pub/sub and the collaboration state. ioredis reads a bare host as that host on
# 6379, database 0; outline's keys carry their own prefixes. Without the collaboration
# URL two pods editing one document do not sync.
REDIS_URL=${dependency:platform-valkey.host}
REDIS_COLLABORATION_URL=${dependency:platform-valkey.host}

# Garage, path-style. A literal until a Project declares Garage.
FILE_STORAGE=s3
AWS_REGION=garage
AWS_S3_UPLOAD_BUCKET_URL=http://garage.data-system.svc.cluster.local:3900
AWS_S3_UPLOAD_BUCKET_NAME=outline-uploads
AWS_S3_FORCE_PATH_STYLE=true
AWS_S3_ACL=private
AWS_ACCESS_KEY_ID=${secret:secret/data/platform/garage#s3.access_key_id}
AWS_SECRET_ACCESS_KEY=${secret:secret/data/platform/garage#s3.secret_access_key}

SECRET_KEY=${secret:secret/data/platform/outline#secret_key}
UTILS_SECRET=${secret:secret/data/platform/outline#utils_secret}

# outline reads no discovery document, so each endpoint is named.
OIDC_CLIENT_ID=outline
OIDC_CLIENT_SECRET=${secret:secret/data/platform/outline#oidc.client_secret}
OIDC_AUTH_URI=${exposure:auth.public#url}/api/oauth2/authorize
OIDC_TOKEN_URI=${exposure:auth.public#url}/api/oauth2/token
OIDC_USERINFO_URI=${exposure:auth.public#url}/api/userinfo
OIDC_USERNAME_CLAIM=preferred_username
OIDC_DISPLAY_NAME=jorisjonkers.dev
OIDC_SCOPES=openid profile email

# 587 is STARTTLS submission; SMTP_SECURE=true would mean implicit TLS and hang.
SMTP_HOST=${dependency:stalwart.host}
SMTP_PORT=${dependency:stalwart.port}
SMTP_USERNAME=notes@jorisjonkers.dev
SMTP_FROM_EMAIL=notes@jorisjonkers.dev
SMTP_PASSWORD=${secret:secret/data/platform/outline#smtp.password}
SMTP_SECURE=false
