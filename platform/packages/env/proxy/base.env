# What the proxy Process and its gate sidecar receive (deploy-kit spec/v1, chapter 10,
# Configuration). Both containers get every line.

# The public URL the proxy writes into the metadata it serves, such as npm tarball URLs.
PROXY_BASE_URL=${exposure:packages.public#url}

# The API keys config/gate.yml accepts, read through Traefik's file-provider templates.
PACKAGES_KEY_CI=${secret:secret/data/packages-system/keys#ci}
PACKAGES_KEY_WORKSTATION=${secret:secret/data/packages-system/keys#workstation}
PACKAGES_KEY_NODES=${secret:secret/data/packages-system/keys#nodes}
