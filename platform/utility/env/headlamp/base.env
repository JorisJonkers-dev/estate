# What the headlamp Process receives (deploy-kit spec/v1, chapter 10, Configuration).
# headlamp reads every flag from HEADLAMP_CONFIG_<FLAG>; these are the flags the old path's
# chart passed as arguments, read from the live Deployment on 2026-10-29.
HEADLAMP_CONFIG_IN_CLUSTER=true
HEADLAMP_CONFIG_IN_CLUSTER_CONTEXT_NAME=main
HEADLAMP_CONFIG_SESSION_TTL=86400
# A public client with PKCE: auth-api holds no secret for it, so there is none to grant.
HEADLAMP_CONFIG_OIDC_CLIENT_ID=headlamp
HEADLAMP_CONFIG_OIDC_IDP_ISSUER_URL=${exposure:auth.public#url}
HEADLAMP_CONFIG_OIDC_SCOPES=openid profile email groups
HEADLAMP_CONFIG_OIDC_CALLBACK_URL=${exposure:headlamp.public#url}/oidc-callback
HEADLAMP_CONFIG_OIDC_USE_PKCE=true
